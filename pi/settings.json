{
  "packages": [
    "npm:pi-terminal-theme",
    "npm:pi-powerline-footer",
    "npm:pi-usage",
    "npm:@lydst/pi-webfetch",
    "npm:@ifi/pi-plan",
    "npm:pi-session-title",
    "npm:pi-cursor-sdk",
    "npm:pi-subagents",
    "npm:@neilurk12/pi-lazygit",
    "npm:pi-caveman",
    "git:github.com/erazemkos/pi-copy-on-select"
  ],
  "lastChangelogVersion": "0.83.0",
  "defaultProvider": "bedrock-mantle",
  "defaultModel": "openai.gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "theme": "terminal-user-card",
  "powerline": {
    "preset": "default",
    "scrollAwayCard": false,
    "copyOnSelect": false
  },
  "copyOnSelect": {
    "enabled": true,
    "clearSelection": "fade",
    "fadeMs": 250,
    "toast": true
  },
  "showHardwareCursor": true,
  "quietStartup": true,
  "enabledModels": [
    "amazon-bedrock/global.anthropic.claude-opus-5",
    "bedrock-mantle/openai.gpt-5.6-sol",
    "bedrock-mantle/openai.gpt-5.6-terra"
  ]
}