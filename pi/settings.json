{
  "packages": [
    "npm:pi-terminal-theme",
    "npm:pi-powerline-footer",
    "npm:pi-usage",
    "npm:@ifi/pi-plan",
    "npm:pi-session-title",
    "npm:pi-subagents",
    "npm:pi-caveman",
    "npm:pi-web-access",
    "npm:pi-grill-wizard",
    "../../gits/pi-copy-code-block"
